                "if": {
                  "properties": {
                    "blockerCount": {
                      "const": 0
                    }
                  }
                },
                "then": {
                  "properties": {
                    "blockers": {
                      "maxItems": 0
                    }
                  }
                },
                "else": {
                  "properties": {
                    "blockers": {
                      "minItems": 1
                    }
                  }
                }
              }
            ]
          }
        },
        "config": {
          "version": 1,
          "agentRef": "agent-agent:7ff05886",
          "prompt": "Review the original calling Agent’s completed work in the current working tree. Inputs contain task, implementationResult and iteration (zero based). Inspect the actual current files and diff on EVERY round, including any changes made after the prior review. Do not edit files or delegate. Identify only release-blocking correctness, security or data-loss problems. Verify each finding against current source and provide a concrete file and evidence. Return structured data exactly matching resultSchema: blockerCount must equal blockers.length; review must contain the full review, including non-blocking observations. A failed or incomplete review is not a clean review. Save any report outside the repository, then submit the required explicit worker-done with data before becoming idle.",
