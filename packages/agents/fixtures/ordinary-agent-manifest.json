{
  "version": 2,
  "primitiveVersion": 2,
  "agents": [
    {
      "id": "fixture-nebula",
      "aliases": ["nebula-cli"],
      "definitionRevision": "fixture-nebula-v1",
      "hook": {
        "relativePath": ".nebula/hooks.json",
        "document": { "eventsPath": ["hooks"] },
        "entry": {
          "commandField": "command",
          "wrapper": { "field": "hooks", "when": "always" }
        },
        "marker": "KMUX_MANAGED_NEBULA_FIXTURE=1",
        "managed": [
          {
            "event": "Completed"
          }
        ],
        "deprecated": [],
        "outputMode": "silent",
        "successResponse": {},
        "fallbackResponse": {},
        "sessionClaim": {
          "startEvents": ["Completed"],
          "sessionIdFields": ["sessionId"]
        }
      }
    },
    {
      "id": "fixture-orbit",
      "aliases": [],
      "definitionRevision": "fixture-orbit-v1",
      "hook": {
        "relativePath": ".orbit/hooks.json",
        "document": { "eventsPath": ["hooks"] },
        "entry": {
          "commandField": "command",
          "wrapper": { "field": "hooks", "when": "always" }
        },
        "marker": "KMUX_MANAGED_ORBIT_FIXTURE=1",
        "managed": [
          {
            "event": "Started"
          }
        ],
        "deprecated": [],
        "outputMode": "silent",
        "successResponse": {},
        "fallbackResponse": {},
        "sessionClaim": {
          "startEvents": ["Started"],
          "sessionIdFields": ["sessionId"]
        }
      },
      "metadata": {
        "defaultRoot": ".orbit/sessions",
        "sources": [
          {
            "role": "fixture-orbit/session-jsonl",
            "format": "jsonl",
            "pattern": "**/*.jsonl",
            "purposes": ["sessions", "usage"],
            "claimScope": "agent"
          }
        ]
      }
    }
  ]
}
