{
  "version": 2,
  "primitiveVersion": 2,
  "agents": [
    {
      "id": "claude",
      "aliases": [],
      "definitionRevision": "claude-v2",
      "hook": {
        "relativePath": ".claude/settings.json",
        "document": { "eventsPath": ["hooks"] },
        "entry": {
          "commandField": "command",
          "wrapper": { "field": "hooks", "when": "always" }
        },
        "marker": "KMUX_MANAGED_CLAUDE_HOOK=1",
        "managed": [
          { "event": "PermissionRequest" },
          { "event": "PreToolUse", "matcher": "AskUserQuestion|ExitPlanMode" },
          { "event": "SessionStart" },
          { "event": "Stop" }
        ],
        "deprecated": [
          "Notification",
          "PostToolUse",
          "SessionEnd",
          "UserPromptSubmit"
        ],
        "outputMode": "silent",
        "successResponse": {},
        "fallbackResponse": {},
        "sessionClaim": {
          "startEvents": ["SessionStart"],
          "sessionIdFields": ["session_id", "sessionId"]
        }
      },
      "metadata": {
        "defaultRoot": ".claude/projects",
        "sources": [
          {
            "role": "claude-session",
            "format": "jsonl",
            "pattern": "**/*.jsonl",
            "purposes": ["sessions", "usage"]
          },
          {
            "role": "claude-subagent",
            "format": "jsonl",
            "pattern": "**/subagents/*.jsonl",
            "purposes": ["usage"]
          }
        ]
      }
    },
    {
      "id": "codex",
      "aliases": [],
      "definitionRevision": "codex-v3",
      "hook": {
        "pathRoot": {
          "defaultHomeRelativePath": ".codex",
          "environmentVariable": "CODEX_HOME"
        },
        "relativePath": "hooks.json",
        "document": { "eventsPath": ["hooks"] },
        "entry": {
          "commandField": "command",
          "wrapper": { "field": "hooks", "when": "always" }
        },
        "marker": "KMUX_MANAGED_CODEX_HOOK=1",
        "managed": [
          { "event": "SessionStart" },
          { "event": "PermissionRequest" },
          { "event": "Stop" }
        ],
        "deprecated": ["UserPromptSubmit"],
        "outputMode": "silent",
        "successResponse": {},
        "fallbackResponse": {},
        "sessionClaim": {
          "startEvents": ["SessionStart"],
          "sessionIdFields": ["session_id", "sessionId"]
        }
      },
      "metadata": {
        "pathRoot": {
          "defaultHomeRelativePath": ".codex",
          "environmentVariable": "CODEX_HOME"
        },
        "defaultRoot": "sessions",
        "sources": [
          {
            "role": "codex-session",
            "format": "jsonl",
            "pattern": "**/*.jsonl",
            "purposes": ["sessions", "usage"]
          }
        ]
      }
    },
    {
      "id": "copilot",
      "aliases": [],
      "definitionRevision": "copilot-v1",
      "hook": {
        "pathRoot": {
          "defaultHomeRelativePath": ".copilot",
          "environmentVariable": "COPILOT_HOME"
        },
        "relativePath": "hooks/kmux.json",
        "document": {
          "eventsPath": ["hooks"],
          "version": { "field": "version", "value": 1 }
        },
        "entry": { "commandField": "bash" },
        "marker": "KMUX_MANAGED_COPILOT_HOOK=1",
        "managed": [
          { "event": "sessionStart" },
          { "event": "notification" },
          { "event": "agentStop" },
          { "event": "sessionEnd" }
        ],
        "deprecated": [],
        "outputMode": "silent",
        "successResponse": {},
        "fallbackResponse": {},
        "sessionClaim": {
          "startEvents": ["sessionStart"],
          "sessionIdFields": ["sessionId", "session_id"]
        }
      },
      "metadata": {
        "pathRoot": {
          "defaultHomeRelativePath": ".copilot",
          "environmentVariable": "COPILOT_HOME"
        },
        "defaultRoot": "session-state",
        "sources": [
          {
            "role": "copilot-session",
            "format": "jsonl",
            "pattern": "*/events.jsonl",
            "purposes": ["sessions", "usage"]
          }
        ]
      }
    },
    {
      "id": "antigravity",
      "aliases": ["agy", "antigravity-cli"],
      "definitionRevision": "antigravity-v2",
      "hook": {
        "relativePath": ".gemini/config/hooks.json",
        "document": { "eventsPath": ["kmux-antigravity"] },
        "entry": {
          "commandField": "command",
          "wrapper": { "field": "hooks", "when": "matcher" }
        },
        "marker": "KMUX_MANAGED_ANTIGRAVITY_HOOK=1",
        "managed": [
          { "event": "PreInvocation" },
          { "event": "PreToolUse", "matcher": ".*" },
          { "event": "Stop" }
        ],
        "deprecated": ["PostToolUse", "PostInvocation"],
        "outputMode": "json",
        "successResponse": { "decision": "allow" },
        "fallbackResponse": { "decision": "allow" },
        "fallbackByEvent": {
          "PreInvocation": {},
          "PreToolUse": { "decision": "allow" },
          "Stop": { "decision": "allow" }
        },
        "sessionClaim": {
          "startEvents": ["PreInvocation"],
          "sessionIdFields": ["conversationId", "conversation_id"]
        }
      },
      "metadata": {
        "defaultRoot": ".gemini/antigravity-cli",
        "sources": [
          {
            "role": "antigravity-history",
            "format": "jsonl",
            "pattern": "history.jsonl",
            "purposes": ["sessions"],
            "claimScope": "agent"
          },
          {
            "role": "antigravity-transcript",
            "format": "jsonl",
            "pattern": "brain/*/.system_generated/logs/transcript.jsonl",
            "purposes": ["sessions", "usage"]
          },
          {
            "role": "antigravity-conversation",
            "format": "sqlite",
            "pattern": "conversations/*.db",
            "purposes": ["sessions"],
            "queryPlanIds": ["antigravity.conversation.steps.v1"]
          }
        ]
      }
    }
  ]
}
