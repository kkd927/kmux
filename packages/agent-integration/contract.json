{
  "contractVersion": 3,
  "commandTemplate": "{marker}; KMUX_AGENT_INTEGRATION_CONTRACT_VERSION=3; _kmux_agent_hook=; if [ -n \"${KMUX_AGENT_BIN_DIR:-}\" ] && [ -x \"${KMUX_AGENT_BIN_DIR}/kmux-agent-hook\" ]; then _kmux_agent_hook=\"${KMUX_AGENT_BIN_DIR}/kmux-agent-hook\"; else _kmux_agent_hook=\"$(command -v kmux-agent-hook 2>/dev/null || true)\"; fi; if [ -n \"$_kmux_agent_hook\" ] && [ -x \"$_kmux_agent_hook\" ]; then KMUX_AGENT_HOOK_OUTPUT_MODE={outputMode} \"$_kmux_agent_hook\" {agent} {event} || {fallback}; else {fallback}; fi",
  "commandWrappers": [
    {
      "agentId": "codex",
      "executable": "codex",
      "homeEnvironmentVariable": "CODEX_HOME",
      "defaultHomeRelativePath": ".codex",
      "integrationRelativePath": "hooks.json",
      "integrationContractMarker": "KMUX_AGENT_INTEGRATION_CONTRACT_VERSION=3",
      "legacyHooksFeature": "codex_hooks",
      "currentHooksFeature": "hooks",
      "currentHooksFeatureMinor": 129,
      "notificationMethod": "osc9",
      "integrationManagedMarker": "KMUX_MANAGED_CODEX_HOOK=1"
    }
  ],
  "vendors": {
    "claude": {
      "relativePath": ".claude/settings.json",
      "document": { "eventsPath": ["hooks"] },
      "entry": {
        "commandField": "command",
        "wrapper": { "field": "hooks", "when": "always" }
      },
      "marker": "KMUX_MANAGED_CLAUDE_HOOK=1",
      "managed": [
        { "event": "PermissionRequest" },
        { "event": "PreToolUse", "matcher": "AskUserQuestion|ExitPlanMode" },
        { "event": "SessionStart" },
        { "event": "Stop" }
      ],
      "deprecated": [
        "Notification",
        "PostToolUse",
        "SessionEnd",
        "UserPromptSubmit"
      ],
      "outputMode": "silent",
      "fallback": "true"
    },
    "codex": {
      "pathRoot": {
        "defaultHomeRelativePath": ".codex",
        "environmentVariable": "CODEX_HOME"
      },
      "relativePath": "hooks.json",
      "document": { "eventsPath": ["hooks"] },
      "entry": {
        "commandField": "command",
        "wrapper": { "field": "hooks", "when": "always" }
      },
      "marker": "KMUX_MANAGED_CODEX_HOOK=1",
      "managed": [
        { "event": "SessionStart" },
        { "event": "PermissionRequest" },
        { "event": "Stop" }
      ],
      "deprecated": ["UserPromptSubmit"],
      "outputMode": "silent",
      "fallback": "true"
    },
    "copilot": {
      "pathRoot": {
        "defaultHomeRelativePath": ".copilot",
        "environmentVariable": "COPILOT_HOME"
      },
      "relativePath": "hooks/kmux.json",
      "document": {
        "eventsPath": ["hooks"],
        "version": { "field": "version", "value": 1 }
      },
      "entry": { "commandField": "bash" },
      "marker": "KMUX_MANAGED_COPILOT_HOOK=1",
      "managed": [
        { "event": "sessionStart" },
        { "event": "notification" },
        { "event": "agentStop" },
        { "event": "sessionEnd" }
      ],
      "deprecated": [],
      "outputMode": "silent",
      "fallback": "true"
    },
    "antigravity": {
      "relativePath": ".gemini/config/hooks.json",
      "document": { "eventsPath": ["kmux-antigravity"] },
      "entry": {
        "commandField": "command",
        "wrapper": { "field": "hooks", "when": "matcher" }
      },
      "marker": "KMUX_MANAGED_ANTIGRAVITY_HOOK=1",
      "managed": [
        { "event": "PreInvocation" },
        { "event": "PreToolUse", "matcher": ".*" },
        { "event": "Stop" }
      ],
      "deprecated": ["PostToolUse", "PostInvocation"],
      "outputMode": "json",
      "fallback": "printf '%s\\n' '{\"decision\":\"allow\"}'",
      "fallbackByEvent": {
        "PreInvocation": "printf '%s\\n' '{}'",
        "PreToolUse": "printf '%s\\n' '{\"decision\":\"allow\"}'",
        "Stop": "printf '%s\\n' '{\"decision\":\"allow\"}'"
      }
    }
  }
}
