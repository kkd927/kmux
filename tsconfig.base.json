{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@kmux/core": ["packages/core/src/index.ts"],
      "@kmux/core/main/path-access": ["packages/core/src/main/pathAccess.ts"],
      "@kmux/core/main": ["packages/core/src/main/index.ts"],
      "@kmux/proto": ["packages/proto/src/index.ts"],
      "@kmux/persistence": ["packages/persistence/src/index.ts"],
      "@kmux/metadata": ["packages/metadata/src/index.ts"],
      "@kmux/metadata/core": ["packages/metadata/src/core/index.ts"],
      "@kmux/metadata/node": ["packages/metadata/src/node/index.ts"],
      "@kmux/agent-integration": ["packages/agent-integration/src/index.ts"],
      "@kmux/agent-integration/planner": [
        "packages/agent-integration/src/planner.ts"
      ],
      "@kmux/agents": ["packages/agents/src/index.ts"],
      "@kmux/agents/composition": ["packages/agents/src/composition.ts"],
      "@kmux/agents/builtin-hooks": ["packages/agents/src/builtinHooks.ts"],
      "@kmux/agents/generated-hook-responses": [
        "packages/agents/src/generatedHookResponses.ts"
      ],
      "@kmux/agents/generated-command-wrappers": [
        "packages/agents/src/generatedCommandWrappers.ts"
      ],
      "@kmux/agents/builtin-subscriptions": [
        "packages/agents/src/builtinSubscriptions.ts"
      ],
      "@kmux/agents/builtin-runtime": ["packages/agents/src/builtinRuntime.ts"],
      "@kmux/agents/antigravity-session-index": [
        "packages/agents/src/builtins/antigravity/sessionIndex.ts"
      ],
      "@kmux/ui": ["packages/ui/src/index.ts"]
    }
  }
}
