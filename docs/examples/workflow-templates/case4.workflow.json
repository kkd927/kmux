            "target": "validationCommand",
            "source": {
              "kind": "run-input",
              "inputId": "validationCommand"
            },
            "required": true,
            "missing": "fail"
          },
          {
            "target": "reportDirectory",
            "source": {
              "kind": "run-input",
              "inputId": "reportDirectory"
            },
            "required": true,
            "missing": "fail"
          },
          {
            "target": "implementation",
            "source": {
              "kind": "node-result",
              "nodeId": "implement"
