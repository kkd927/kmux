      "definition": {
        "id": "prepare",
        "kind": "agent",
        "title": "Inspect the assigned new worktree",
        "config": {
          "version": 1,
          "agentRef": "environmentAgent",
          "prompt": "The Runtime has already created this isolated worktree. Record its actual working directory, branch and baseline HEAD; inspect project setup requirements for task. Do not create another worktree or implement the task. The Runtime completion receipt identifies this worktree for later stages.\n\nUse the resolved inputs and the project conventions in the assigned working directory. Preserve unrelated edits. Treat task, acceptanceCriteria and constraints as the scope; do not invent extra requirements. Execute validationCommand when this stage calls for validation and report exact commands and actual outcomes.\nReturn data matching the declared result schema. When it declares summary, data.summary must contain the complete useful plan, decisions or work result and executed checks needed by the next stage. Report work performed, findings, validation and remaining work in your explicit completion result. Include the full useful result, not just a terminal pointer or a report path. If reportDirectory is nonempty, write a unique report using this Run/Task identity to that user-supplied absolute directory outside the working tree and attach its path. Otherwise return the report in the completion result without inventing a filesystem location. Do not commit, push or publish unless the stage explicitly asks for a local commit or merge. For a blocker, ask the Coordinator or fail the Task truthfully.",
          "lifecycleMode": "managed",
          "coding": false
        },
        "inputMappings": [
          {
            "target": "task",
            "source": {
              "kind": "run-input",
              "inputId": "task"
            },
            "required": true,
            "missing": "fail"
          },
          {
            "target": "acceptanceCriteria",
