        "title": "Choose a committed baseline first",
        "config": {
          "version": 1,
          "question": "The source checkout is not clean. Preserve the existing work and choose a committed baseline before comparing alternatives; this Workflow does not clean or commit it automatically.",
          "resolutions": [
