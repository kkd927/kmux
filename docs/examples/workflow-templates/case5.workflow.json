      "definition": {
        "id": "reproduce",
        "kind": "agent",
        "title": "Establish the failing behavior",
        "config": {
          "version": 1,
          "agentRef": "implementationAgent",
          "prompt": "Use the complete resolved issue. Reproduce the reported behavior with an actual command or a focused regression test. You may add a reproduction test but must not change production behavior yet. Return data {reproduced,trigger,expected,actual}; reproduced=true requires actual observed evidence. Record why reproduction is unavailable rather than inventing one.\n\nUse the resolved inputs and the project conventions in the assigned working directory. Preserve unrelated edits. Treat task, acceptanceCriteria and constraints as the scope; do not invent extra requirements. Execute validationCommand when this stage calls for validation and report exact commands and actual outcomes.\nReturn data matching the declared result schema. When it declares summary, data.summary must contain the complete useful plan, decisions or work result and executed checks needed by the next stage. Report work performed, findings, validation and remaining work in your explicit completion result. Include the full useful result, not just a terminal pointer or a report path. If reportDirectory is nonempty, write a unique report using this Run/Task identity to that user-supplied absolute directory outside the working tree and attach its path. Otherwise return the report in the completion result without inventing a filesystem location. Do not commit, push or publish unless the stage explicitly asks for a local commit or merge. For a blocker, ask the Coordinator or fail the Task truthfully.",
          "lifecycleMode": "managed",
          "coding": true
        },
        "inputMappings": [
          {
            "target": "task",
            "source": {
              "kind": "run-input",
              "inputId": "task"
            },
            "required": true,
            "missing": "fail"
          },
          {
            "target": "acceptanceCriteria",
