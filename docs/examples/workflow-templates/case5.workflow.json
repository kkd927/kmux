      "definition": {
        "id": "read-issue",
        "kind": "agent",
        "title": "Read the supplied Issue",
        "config": {
          "version": 1,
          "agentRef": "issueAgent",
          "prompt": "Read issue from resolved inputs. If it is an Issue URL/reference, retrieve it through the available authenticated read-only GitHub tools; otherwise preserve the supplied text. Return data {title,body,url} with the complete useful issue content. Do not publish or invent unavailable issue details. Report a blocker if retrieval is required but unavailable.\n\nUse the resolved inputs and the project conventions in the assigned working directory. Preserve unrelated edits. Treat task, acceptanceCriteria and constraints as the scope; do not invent extra requirements. Execute validationCommand when this stage calls for validation and report exact commands and actual outcomes.\nReturn data matching the declared result schema. When it declares summary, data.summary must contain the complete useful plan, decisions or work result and executed checks needed by the next stage. Report work performed, findings, validation and remaining work in your explicit completion result. Include the full useful result, not just a terminal pointer or a report path. If reportDirectory is nonempty, write a unique report using this Run/Task identity to that user-supplied absolute directory outside the working tree and attach its path. Otherwise return the report in the completion result without inventing a filesystem location. Do not commit, push or publish unless the stage explicitly asks for a local commit or merge. For a blocker, ask the Coordinator or fail the Task truthfully.",
          "lifecycleMode": "managed",
          "coding": false
        },
        "inputMappings": [
          {
            "target": "task",
            "source": {
              "kind": "run-input",
              "inputId": "task"
            },
