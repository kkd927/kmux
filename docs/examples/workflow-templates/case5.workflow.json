          },
          {
            "target": "reportDirectory",
            "source": {
              "kind": "run-input",
              "inputId": "reportDirectory"
            },
            "required": true,
            "missing": "fail"
          },
          {
            "target": "issue",
            "source": {
              "kind": "node-result",
              "nodeId": "read-issue"
            },
            "required": true,
            "missing": "fail"
          }
        ],
        "resultSchema": {
