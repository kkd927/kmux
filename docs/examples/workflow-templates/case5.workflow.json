    {
      "id": "review-loop",
      "position": {
        "x": 2420,
        "y": 120
      },
      "definition": {
        "id": "review-loop",
        "kind": "loop",
        "title": "Independent review · up to two fixes",
        "config": {
          "version": 1,
          "mode": "while",
          "maxIterations": 3,
          "body": {
            "nodeIds": [
              "review",
              "review-decision",
              "fix-budget",
              "correct",
              "unresolved"
            ],
            "entryNodeIds": [
              "review"
            ],
            "exits": [
              {
                "nodeId": "review-decision",
                "port": "clean",
                "outcome": "clean"
              },
              {
                "nodeId": "correct",
                "port": "success",
                "outcome": "repeat"
              },
              {
                "nodeId": "unresolved",
                "outcome": "unresolved",
                "action": "continue"
              }
            ]
          },
          "repeatOutcome": "repeat",
          "completedOutcomes": [
            "clean"
          ],
          "completedPort": "clean",
          "maxReachedPort": "limit",
          "carry": [
            {
              "inputId": "previousReview",
              "initial": {
                "kind": "literal",
                "value": null
              },
              "next": {
                "kind": "node-result",
                "nodeId": "review"
              }
            }
          ]
        }
      }
    },
    {
      "id": "review",
      "position": {
        "x": 80,
        "y": 171
      },
      "definition": {
        "id": "review",
        "kind": "agent",
        "title": "Independent review",
        "config": {
          "version": 1,
