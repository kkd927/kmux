                "kind": "literal",
                "value": "-c"
              },
              {
                "kind": "input",
                "input": "command"
              }
            ]
          },
          "targetPolicy": "local",
          "surfacePolicy": "create",
          "cwdPolicy": "workspace",
          "resultMode": "exit-code",
