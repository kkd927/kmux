            "properties": {
              "summary": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "joinPolicy": "all-successful"
      }
    },
    {
      "id": "verify",
      "position": {
        "x": 1500,
        "y": 368
      },
      "definition": {
        "id": "verify",
        "kind": "agent",
        "title": "Independent verification",
        "config": {
          "version": 1,
          "agentRef": "verificationAgent",
          "prompt": "Independently verify the CURRENT implementation against task and acceptanceCriteria, upstream results and the actual changed code. Run validationCommand and relevant contract checks. Return data {passed,checks,issues}. Set passed=false for any failed check or unresolved required criterion; use a failed Task outcome for an operational blocker.\n\nUse the resolved inputs and the project conventions in the assigned working directory. Preserve unrelated edits. Treat task, acceptanceCriteria and constraints as the scope; do not invent extra requirements. Execute validationCommand when this stage calls for validation and report exact commands and actual outcomes.\nReturn data matching the declared result schema. When it declares summary, data.summary must contain the complete useful plan, decisions or work result and executed checks needed by the next stage. Report work performed, findings, validation and remaining work in your explicit completion result. Include the full useful result, not just a terminal pointer or a report path. If reportDirectory is nonempty, write a unique report using this Run/Task identity to that user-supplied absolute directory outside the working tree and attach its path. Otherwise return the report in the completion result without inventing a filesystem location. Do not commit, push or publish unless the stage explicitly asks for a local commit or merge. For a blocker, ask the Coordinator or fail the Task truthfully.",
          "lifecycleMode": "managed",
          "coding": false
        },
        "inputMappings": [
          {
            "target": "task",
            "source": {
              "kind": "run-input",
              "inputId": "task"
            },
            "required": true,
            "missing": "fail"
          },
          {
            "target": "acceptanceCriteria",
            "source": {
              "kind": "run-input",
              "inputId": "acceptanceCriteria"
            },
            "required": true,
            "missing": "fail"
          },
          {
            "target": "constraints",
            "source": {
              "kind": "run-input",
              "inputId": "constraints"
            },
            "required": true,
            "missing": "fail"
          },
          {
            "target": "validationCommand",
            "source": {
              "kind": "run-input",
              "inputId": "validationCommand"
            },
            "required": true,
            "missing": "fail"
          },
          {
            "target": "reportDirectory",
            "source": {
              "kind": "run-input",
              "inputId": "reportDirectory"
            },
            "required": true,
            "missing": "fail"
          },
          {
            "target": "research",
            "source": {
              "kind": "node-result",
              "nodeId": "research"
            },
            "required": true,
            "missing": "fail"
          },
          {
            "target": "design",
            "source": {
              "kind": "node-result",
              "nodeId": "design"
            },
            "required": true,
            "missing": "fail"
          },
          {
            "target": "implementation",
            "source": {
              "kind": "node-result",
              "nodeId": "implement"
            },
            "required": true,
            "missing": "fail"
          }
        ],
        "resultSchema": {
          "schema": {
            "type": "object",
            "required": [
              "passed",
              "checks",
              "issues"
            ],
            "properties": {
              "passed": {
                "type": "boolean"
              },
              "checks": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "issues": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    {
      "id": "verification-passed",
      "position": {
        "x": 1960,
        "y": 549
      },
      "definition": {
        "id": "verification-passed",
        "kind": "condition",
        "title": "Verification passed?",
        "config": {
          "version": 1,
          "expressionVersion": 1,
          "expression": "false",
          "ports": [
            "yes",
            "else"
          ],
          "conditions": [
            {
              "key": "yes",
              "left": {
                "kind": "node-result",
                "nodeId": "verify",
                "path": [
                  "passed"
                ]
              },
              "operator": "eq",
              "right": {
                "kind": "literal",
                "value": true
              }
            }
          ]
        }
      }
    },
    {
      "id": "final-validation",
      "position": {
        "x": 2420,
        "y": 482
      },
      "definition": {
        "id": "final-validation",
        "kind": "shell",
        "title": "Run project validation",
        "inputMappings": [
          {
            "target": "command",
            "source": {
              "kind": "run-input",
              "inputId": "validationCommand"
            },
            "required": true,
            "missing": "fail"
          }
        ],
        "config": {
          "version": 1,
          "command": {
            "kind": "structured",
            "executable": "/bin/sh",
            "args": [
              {
                "kind": "literal",
                "value": "-c"
              },
              {
                "kind": "input",
                "input": "command"
              }
            ]
          },
          "targetPolicy": "local",
          "surfacePolicy": "create",
          "cwdPolicy": "workspace",
          "resultMode": "exit-code",
          "maxOutputBytes": 1048576
        }
      }
    },
    {
      "id": "verification-stop",
      "position": {
        "x": 2420,
        "y": 616
      },
      "definition": {
        "id": "verification-stop",
        "kind": "human-gate",
        "title": "Verification requires attention",
        "config": {
          "version": 1,
          "question": "Verification reported unresolved issues. Inspect its full result. Stop this run and address the problem; this decision does not approve the implementation.",
          "resolutions": [
            "stop"
          ],
          "approverPolicy": "local-user"
        },
        "inputMappings": [
          {
            "target": "verification",
            "source": {
              "kind": "node-result",
              "nodeId": "verify"
            },
            "required": true,
            "missing": "fail"
          }
        ]
      }
    },
    {
      "id": "done",
      "position": {
        "x": 2880,
        "y": 549
      },
      "definition": {
        "id": "done",
        "kind": "end",
        "title": "Finished / stopped",
        "config": {
          "version": 1
        },
        "completionRoot": true,
        "joinPolicy": "any-successful",
        "anySuccessfulDisposition": "wait"
      }
    }
