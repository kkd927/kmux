    },
    {
      "id": "research",
      "position": {
        "x": 580,
        "y": 120
      },
      "definition": {
        "id": "research",
        "kind": "agent",
        "title": "Research project constraints",
        "config": {
          "version": 1,
          "agentRef": "researchAgent",
          "prompt": "Read-only investigate the supplied task, existing project behavior, relevant APIs, dependencies and risks. Provide concrete findings and recommendations for the implementer. Include the useful evidence in the completion result.\n\nUse the resolved inputs and the project conventions in the assigned working directory. Preserve unrelated edits. Treat task, acceptanceCriteria and constraints as the scope; do not invent extra requirements. Execute validationCommand when this stage calls for validation and report exact commands and actual outcomes.\nReturn data matching the declared result schema. When it declares summary, data.summary must contain the complete useful plan, decisions or work result and executed checks needed by the next stage. Report work performed, findings, validation and remaining work in your explicit completion result. Include the full useful result, not just a terminal pointer or a report path. If reportDirectory is nonempty, write a unique report using this Run/Task identity to that user-supplied absolute directory outside the working tree and attach its path. Otherwise return the report in the completion result without inventing a filesystem location. Do not commit, push or publish unless the stage explicitly asks for a local commit or merge. For a blocker, ask the Coordinator or fail the Task truthfully.",
          "lifecycleMode": "managed",
          "coding": false
        },
        "inputMappings": [
          {
            "target": "task",
            "source": {
              "kind": "run-input",
              "inputId": "task"
            },
            "required": true,
            "missing": "fail"
          },
          {
            "target": "acceptanceCriteria",
            "source": {
              "kind": "run-input",
              "inputId": "acceptanceCriteria"
            },
            "required": true,
            "missing": "fail"
          },
          {
            "target": "constraints",
            "source": {
              "kind": "run-input",
              "inputId": "constraints"
            },
            "required": true,
            "missing": "fail"
          },
          {
            "target": "validationCommand",
            "source": {
              "kind": "run-input",
              "inputId": "validationCommand"
            },
            "required": true,
            "missing": "fail"
          },
          {
            "target": "reportDirectory",
            "source": {
              "kind": "run-input",
              "inputId": "reportDirectory"
            },
            "required": true,
            "missing": "fail"
          }
        ],
        "resultSchema": {
          "schema": {
            "type": "object",
            "required": [
              "summary"
            ],
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "id": "design",
      "position": {
        "x": 580,
        "y": 616
      },
      "definition": {
        "id": "design",
        "kind": "agent",
        "title": "Design implementation and checks",
        "config": {
          "version": 1,
          "agentRef": "designAgent",
          "prompt": "Read-only design an implementation approach, interfaces, ownership boundaries and acceptance checks for the supplied task. Document assumptions rather than invent requirements. Include the complete useful design in the result.\n\nUse the resolved inputs and the project conventions in the assigned working directory. Preserve unrelated edits. Treat task, acceptanceCriteria and constraints as the scope; do not invent extra requirements. Execute validationCommand when this stage calls for validation and report exact commands and actual outcomes.\nReturn data matching the declared result schema. When it declares summary, data.summary must contain the complete useful plan, decisions or work result and executed checks needed by the next stage. Report work performed, findings, validation and remaining work in your explicit completion result. Include the full useful result, not just a terminal pointer or a report path. If reportDirectory is nonempty, write a unique report using this Run/Task identity to that user-supplied absolute directory outside the working tree and attach its path. Otherwise return the report in the completion result without inventing a filesystem location. Do not commit, push or publish unless the stage explicitly asks for a local commit or merge. For a blocker, ask the Coordinator or fail the Task truthfully.",
          "lifecycleMode": "managed",
          "coding": false
        },
        "inputMappings": [
          {
            "target": "task",
            "source": {
              "kind": "run-input",
              "inputId": "task"
            },
            "required": true,
            "missing": "fail"
          },
          {
            "target": "acceptanceCriteria",
            "source": {
              "kind": "run-input",
              "inputId": "acceptanceCriteria"
            },
            "required": true,
            "missing": "fail"
          },
          {
            "target": "constraints",
            "source": {
              "kind": "run-input",
              "inputId": "constraints"
            },
            "required": true,
            "missing": "fail"
          },
          {
            "target": "validationCommand",
            "source": {
              "kind": "run-input",
              "inputId": "validationCommand"
            },
            "required": true,
            "missing": "fail"
          },
          {
            "target": "reportDirectory",
            "source": {
              "kind": "run-input",
              "inputId": "reportDirectory"
            },
            "required": true,
            "missing": "fail"
          }
        ],
        "resultSchema": {
          "schema": {
            "type": "object",
            "required": [
              "summary"
            ],
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "id": "implement",
      "position": {
        "x": 1040,
        "y": 368
      },
      "definition": {
        "id": "implement",
        "kind": "agent",
        "title": "Implement both upstream decisions",
        "config": {
          "version": 1,
          "agentRef": "implementationAgent",
          "prompt": "Wait for and read BOTH research and design from resolved inputs. Resolve conflicts against task and project evidence, implement the agreed scope, and run validationCommand. Explain how each upstream result informed the work.\n\nUse the resolved inputs and the project conventions in the assigned working directory. Preserve unrelated edits. Treat task, acceptanceCriteria and constraints as the scope; do not invent extra requirements. Execute validationCommand when this stage calls for validation and report exact commands and actual outcomes.\nReturn data matching the declared result schema. When it declares summary, data.summary must contain the complete useful plan, decisions or work result and executed checks needed by the next stage. Report work performed, findings, validation and remaining work in your explicit completion result. Include the full useful result, not just a terminal pointer or a report path. If reportDirectory is nonempty, write a unique report using this Run/Task identity to that user-supplied absolute directory outside the working tree and attach its path. Otherwise return the report in the completion result without inventing a filesystem location. Do not commit, push or publish unless the stage explicitly asks for a local commit or merge. For a blocker, ask the Coordinator or fail the Task truthfully.",
          "lifecycleMode": "managed",
          "coding": true
        },
        "inputMappings": [
          {
            "target": "task",
            "source": {
              "kind": "run-input",
              "inputId": "task"
            },
            "required": true,
            "missing": "fail"
          },
          {
            "target": "acceptanceCriteria",
            "source": {
              "kind": "run-input",
              "inputId": "acceptanceCriteria"
            },
            "required": true,
            "missing": "fail"
          },
          {
            "target": "constraints",
