        "maxEdges": 512,
        "maxGraphDepth": 32,
        "maxFanOut": 16,
        "maxLoopIterations": 12,
        "maxActiveAttempts": 3,
        "maxAttemptsPerSession": 8,
        "maxDispatches": 128,
        "maxCoordinatorTurns": 32,
        "maxGraphPatches": 128,
        "maxWallClockMs": 86400000,
